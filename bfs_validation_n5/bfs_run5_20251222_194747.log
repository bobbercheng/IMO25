n\\[\n\\boxed{\n\\begin{aligned}\n&\\text{If }n\\text{ is even }(\\,n\\ge4\\,): &&k\\in\\{0,1,n-1\\},\\\\[2mm]\n&\\text{If }n\\text{ is odd }(\\,n\\ge3\\,):  &&k\\in\\{0,1,2,\\dots ,n\\}.\n\\end{aligned}}\n\\]"

